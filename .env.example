# 개발·테스트용 기본값 — `npm run dev`, `npm run build:test`에서 쓴다.
# 운영 ID로 테스트하면 제재 대상이라 여기에는 테스트 값만 둔다.
VITE_PROMOTION_CODE=
# 보상형(30초, 긴 광고) — 풍경·고양이 열기
VITE_REWARDED_AD_GROUP_ID=
# 전면형(5초, 짧은 광고) — 가득 찬 유리병을 토스 포인트로 교환
VITE_INTERSTITIAL_AD_GROUP_ID=
# 이미지 강조 배너(피드형)
VITE_BANNER_AD_GROUP_ID=
# 문구 강조 배너(리스트형) — 풍경만 보기 바닥
VITE_TEXT_BANNER_AD_GROUP_ID=
